# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Google service account ---
# Email of the calendar/Gmail account the service account impersonates
CalID=owner@example.com

# --- Flask web app login (single operator) ---
UserN=changeme
PassW=changeme
FLASK_SECRET_KEY=generate-a-long-random-hex-string

# --- MySQL / MariaDB ---
DBuser=bookings_user
DBpass=changeme

# --- Gmail filtering ---
# Only emails from this sender address are treated as new booking requests
SenderID=orders@example.com

# --- Pushover alerts (owner's phone) ---
PushToken=your-pushover-app-token
PushJames=owner-pushover-user-key

# --- WordPress / WooCommerce invoicing (Selenium) ---
WPlogin=https://example.com/wp-login.php
WPuser=wp_admin
WPpass=changeme
